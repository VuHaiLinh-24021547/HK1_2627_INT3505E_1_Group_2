# dev (Postgres + Redis + RQ) | devlite (SQLite + fakeredis + thread) | test | prod
APP_CONFIG=devlite
FLASK_APP=app:create_app

# Riot Games API key (never commit the real value)
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

DATABASE_URL=postgresql+psycopg://lol:lol@localhost:5432/lol_match_history
REDIS_URL=redis://localhost:6379/0

SYNC_COOLDOWN_SEC=120
# rq | thread | inline
SYNC_MODE=rq

# JWT / OAuth 2.0 (RS256)
JWT_ISSUER=http://127.0.0.1:5000
JWT_AUDIENCE=lol-match-history-api
JWT_ACCESS_TTL_SEC=900
JWT_PRIVATE_KEY_PATH=instance/keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=instance/keys/jwt_public.pem
# Optional: external IdP JWKS endpoint (prod)
JWT_JWKS_URL=

# Built-in client-credentials clients: {"client_id": {"secret": "...", "scopes": ["..."]}}
OAUTH_CLIENTS={"demo-client": {"secret": "demo-secret", "scopes": ["players:read", "players:sync", "matches:read", "static:read"]}}
